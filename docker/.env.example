# ---- which host serial device to map into the container ----
# /dev/cr300 is the stable udev symlink (see README). On a machine without
# that rule, use the by-id path, e.g.:
#   SERIAL_DEV=/dev/serial/by-id/usb-1a86_USB_Dual_Serial_56F3023938-if02
SERIAL_DEV=/dev/cr300

# ---- collector ----
STATION=narit_cr300
CR300_TABLE=Every60
POLL_SECONDS=300
BACKFILL_HOURS=6
LOGGER_OFFSET_HOURS=-7
TZ=Asia/Bangkok

# ---- api ----
API_PORT=8000

# ---- optional InfluxDB (leave blank to keep CSV-only) ----
# INFLUX_URL=http://influxdb:8086
# INFLUX_TOKEN=
# INFLUX_ORG=narit
# INFLUX_BUCKET=cr300
# INFLUX_MEASUREMENT=weather
